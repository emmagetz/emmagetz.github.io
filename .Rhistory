values = c("Very High" = "green", "High" = "yellow", "Medium" = "orange", "Low" = "red"),
breaks = c("Very High", "High", "Medium", "Low")) +
labs(title = "Maternal Mortality from 1990 to 2021 by Human Development Groups",
x = "Year",
y = "Average Maternal Mortality Rate (per 100 000 live births)",
color = "Human Development Groups"
) +
theme_bw()
maternalmortality_US <- maternalmortality_long %>%
filter(Country == "United States")
ggplot(maternalmortality_US, aes(x = Year, y = MMR)) +
geom_point() +
geom_line() +
labs(
title = "Maternal Mortality Rate in the United States from 1990 to 2021",
x = "Year",
y = "Maternal Mortality Rate (per 100 000 live births)") +
scale_y_continuous(breaks = 11:20) +
theme_bw()
maternalmortality_veryhigh_excluding_US <- maternalmortality_long %>%
filter(Human.Development.Groups == "Very High" & Country != "United States") %>%
group_by(Year) %>%
summarize(average_veryhigh_MMR = mean(MMR, na.rm = TRUE))
veryhigh_excluding_US_joined_with_US <- maternalmortality_veryhigh_excluding_US %>%
left_join(maternalmortality_US, by = "Year")
ggplot(veryhigh_excluding_US_joined_with_US, aes(x = Year)) +
geom_line(aes(y = average_veryhigh_MMR, color = "Avg. MMR - Very High HDG (excl. US)"), size = 1) +
geom_line(aes(y = MMR, color = "US MMR"), size = 1) +
scale_color_manual(values = c("Avg. MMR - Very High HDG (excl. US)" = "blue", "US MMR" = "red")) +
labs(
title = "Maternal Mortality Rate (1990–2021): US vs. 'Very High' HDG Countries",
y = "Maternal Mortality Rate (per 100 000 live births)",
color = "Legend"
) +
scale_y_continuous(breaks = 11:29) +
theme_bw()
View(maternalmortality_long)
ggplot(maternalmortality_long_2021, aes(x = "UNDP.Developing.Regions", y = "MMR")) +
geom_bar(stat = "identity", fill = "skyblue")
maternalmortality_long_2021_UNDP <- maternalmortality_long_2021 %>%
filter(!is.na(UNDP.Developing.Regions) & UNDP.Developing.Regions != "")
ggplot(maternalmortality_2021_filtered, aes(x = UNDP.Developing.Regions, y = MMR)) +
geom_bar(stat = "identity", fill = "skyblue") +
labs(title = "Maternal Mortality Ratios by UNDP Developing Regions in 2021",
x = "UNDP Developing Regions",
y = "Maternal Mortality Ratio (MMR)") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
maternalmortality_long_2021_UNDP <- maternalmortality_long_2021 %>%
filter(!is.na(UNDP.Developing.Regions) & UNDP.Developing.Regions != "")
ggplot(maternalmortality_long_2021_UNDP, aes(x = UNDP.Developing.Regions, y = MMR)) +
geom_bar(stat = "identity", fill = "skyblue") +
labs(title = "Maternal Mortality Ratios by UNDP Developing Regions in 2021",
x = "UNDP Developing Regions",
y = "Maternal Mortality Ratio (MMR)") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
maternalmortality_long_2021_UNDP <- maternalmortality_long_2021 %>%
filter(!is.na(UNDP.Developing.Regions) & UNDP.Developing.Regions != "")
ggplot(maternalmortality_long_2021_UNDP, aes(x = UNDP.Developing.Regions, y = MMR)) +
geom_box() +
labs(title = "Maternal Mortality Ratios by UNDP Developing Regions in 2021",
x = "UNDP Developing Regions",
y = "Maternal Mortality Ratio (MMR)") +
theme_bw() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
maternalmortality_long_2021_UNDP <- maternalmortality_long_2021 %>%
filter(!is.na(UNDP.Developing.Regions) & UNDP.Developing.Regions != "")
ggplot(maternalmortality_long_2021_UNDP, aes(x = UNDP.Developing.Regions, y = MMR)) +
geom_boxplot() +
labs(title = "Maternal Mortality Ratios by UNDP Developing Regions in 2021",
x = "UNDP Developing Regions",
y = "Maternal Mortality Ratio (MMR)") +
theme_bw() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
maternalmortality_long_2021_UNDP <- maternalmortality_long_2021 %>%
filter(!is.na(UNDP.Developing.Regions) & UNDP.Developing.Regions != "")
ggplot(maternalmortality_long_2021_UNDP, aes(x = UNDP.Developing.Regions, y = MMR)) +
